# Copy this file to .env and replace the PIHOLE_PASSWORD value.

# Single quotes keep characters such as $ literal in Docker Compose .env files.
PIHOLE_PASSWORD='replace-with-a-long-random-password'

# Docker network settings for the private DNS bridge used by Pi-hole and unbound.
# Leave these defaults unchanged unless they conflict with your host or another Docker network.
# UNBOUND_IP and PIHOLE_IP must remain inside DNS_SUBNET.
DNS_SUBNET=172.31.0.0/24
UNBOUND_IP=172.31.0.2
PIHOLE_IP=172.31.0.3
